# Victorio ABC — web/ environment (copy to web/.env; never commit web/.env)
# Use ONLY the public anon/publishable key here. NEVER put the service_role / secret key in web/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development API (production uses same-origin /api/v1 on Vercel)
VITE_API_URL=http://localhost:5000/api/v1

# Optional Non-Essential Analytics / Marketing Scripts (Loaded ONLY when user clicks "Accept All" in Cookie Consent)
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_CHAT_WIDGET_URL=
